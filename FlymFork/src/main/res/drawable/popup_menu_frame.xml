<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊: popup / overflow menu panel — black, framed by a thin rounded accent outline so the
     menu stands apart from the black page behind it. The padding keeps the first and last rows
     clear of the rounded corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/menu_pref_bg"/>
    <stroke android:width="1.25dp" android:color="@color/menu_pref_fg"/>
    <corners android:radius="12dp"/>
    <padding android:left="1.25dp" android:right="1.25dp" android:top="6dp" android:bottom="6dp"/>
</shape>
